POSTGRES_DB=face_recognition
POSTGRES_USER=face_recognition
POSTGRES_PASSWORD=

# Where reference photos (known persons, one photo per file, used to build the persons table) live
REFERENCE_IMAGES_DIR=

# Where bulk/test images (to be ingested and searched) live
IMAGES_DIR=

# Azure AD app registration used for OneDrive folder ingestion (device-code
# sign-in, no client secret). Run scripts/onedrive_auth_setup.py once after
# setting these to complete the interactive sign-in.
MS_CLIENT_ID=
MS_TENANT_ID=
# Where the signed-in device-code session's token cache is persisted, so the
# server can silently refresh it without a human present on every request.
ONEDRIVE_TOKEN_CACHE_PATH=.onedrive_token_cache.json

# Admin panel login (HTTP Basic Auth). Set a real password here -- the
# fallback in api/config.py ("admin"/"admin") is dev-only and insecure.
ADMIN_USERNAME=
ADMIN_PASSWORD=
